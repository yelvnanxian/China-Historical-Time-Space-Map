{
  "name": "historical-atlas",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --include data/catalog.json server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test server/*.test.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.11.1",
    "opencc-js": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
