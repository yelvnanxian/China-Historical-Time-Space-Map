  "entries": [
    {
      "id": "county-focus-tangcheng",
      "settlementIds": [
        "chgis-county-43627"
      ],
      "boundaryIds": [
        "hartwell-741-county-v5_0741_chin_chn_0741_c-695"
      ],
      "title": "唐城县：建置年份有异文，方位记载不能代替县界",
      "correspondence": "same-unit",
      "summary": "随州唐城县的身份和分置背景有史料支持，但《两唐书》记开元二十六年（738）置县，《元和郡县图志》本次所见版本记二十四年（736）奏置，现并列保留。",
      "findings": [
        {
          "topic": "administration",
          "statement": "《旧唐书》随州条记天宝元年改汉东郡；《新唐书》在同一州郡下列唐城，与模型“山南／随”所属相符。",
          "evidence": [
            {
              "sourceId": "tang-nw-jiutangshu-39",
              "quote": "天寶元年，改為漢東郡。乾元元年，復為隋州。",
              "locator": "卷39·隋州（随州）；归档文本第668行"
            },
            {
              "sourceId": "county-focus-xintangshu-40",
              "quote": "隋州漢東郡，上。土貢：合羅、綾、葛、覆盆。戶二萬三千九百一十七，口十萬五千七百二十二。縣四。隋，〈上。武德四年省安貴縣入焉。五年省平林、順義縣入焉。〉光化，〈上。〉棗陽，〈上。本隸唐州。武德五年省唐州之清潭縣入焉。貞觀元年又省唐州之舂陵縣入焉。十年以棗陽來屬。有光武山。〉唐城。〈上。開元二十六年以客戶析棗陽地置。〉",
              "locator": "卷40·隋州汉东郡；归档文本第50行"
            }
          ]
        },
        {
          "topic": "establishment",
          "statement": "《旧唐书》记738年分枣阳置县，《新唐书》补充“以客户析枣阳地置”；《元和郡县图志》记736年宋鼎奏置。它们可能涉及版本或记事口径差异，本轮不能裁定，不将其中一说覆盖为唯一事实。",
          "evidence": [
            {
              "sourceId": "tang-nw-jiutangshu-39",
              "quote": "唐城 開元二十六年，分棗陽置。",
              "locator": "卷39·唐城；归档文本第672行"
            },
            {
              "sourceId": "county-focus-xintangshu-40",
              "quote": "唐城。〈上。開元二十六年以客戶析棗陽地置。〉",
              "locator": "卷40·唐城；归档文本第50行"
            },
            {
              "sourceId": "county-focus-yuanhe-21",
              "quote": "唐城縣，上。東南至州一百五里。本漢隨縣地，梁於此置下溠戍。後沒魏，改為下溠鎮。隋開皇三年，改鎮為唐城縣，大業二年廢。開元二十四年，采訪使宋鼎奏置。",
              "locator": "卷21·随州·唐城县；归档文本第127行"
            }
          ]
        },
        {
          "topic": "seat",
          "statement": "《元和郡县图志》记县治东南至随州一百零五里，唐城山在县北三十二里。这是方位和相对里程资料，未提供县域边线，也不能直接换算成现代坐标。",
          "evidence": [
            {
              "sourceId": "county-focus-yuanhe-21",
              "quote": "唐城縣，上。東南至州一百五里。",
              "locator": "卷21·唐城县；归档文本第127行"
            },
            {
              "sourceId": "county-focus-yuanhe-21",
              "quote": "唐城山，在縣北三十二里。",
              "locator": "卷21·唐城县；归档文本第128行"
            }
          ]
        },
        {
          "topic": "seat",
          "statement": "地图点位的“今湖北省随州市西北唐县镇”来自CHGIS原记录；目前是数据集定位，尚未获得独立遗址测绘来核准该点。",
          "evidence": [
            {
              "sourceId": "county-focus-chgis",
              "quote": "SYS_ID=43627\nNAME_CH=唐城县\nPRES_LOC=今湖北省随州市西北唐县镇",
              "locator": "CHGIS SYS_ID 43627；归档文本第1行"
            }
          ]
        }
      ],
      "unresolved": [
        "736年与738年置县记载须进一步做版本校勘及事件区分；现有来源不足以消除异文。",
        "CHGIS记录末年912及其后的更名时点，本轮取得的古籍段落未直接证实；记录末年不应直接当成更名年。",
        "县治精确位置及741／755年的县界仍待考证；8.9千米是源点至近似模型的距离，不是迁城距离。"
      ]
    },
    {
      "id": "county-focus-jiyang-hubei",
      "settlementIds": [
        "chgis-county-43673"
      ],
      "boundaryIds": [
        "hartwell-741-county-v5_0741_chin_chn_0741_c-1029"
      ],
      "title": "湖北吉阳县：606年改名有据，后期曾省复置",
      "correspondence": "same-unit",
      "summary": "已补到隋大业二年（606）改名、元和三年（808）省入应山后复置，以及宋开宝年间废县的记载；原数据的一段连续年限不能代表期间从未撤并。",
      "findings": [
        {
          "topic": "establishment",
          "statement": "《旧唐书》记梁置平阳、后魏改京池、隋改吉阳；《元和郡县图志》进一步记改名在大业二年（606），因县北吉阳山得名。",
          "evidence": [
            {
              "sourceId": "tang-nw-jiutangshu-40",
              "quote": "吉陽，梁分安陸置平陽縣，後魏改為京池。隋改為吉陽，取山名。",
              "locator": "卷40·安州·吉阳；归档文本第93行"
            },
            {
              "sourceId": "county-focus-yuanhe-27",
              "quote": "隋大業二年改為吉陽，因縣北吉陽山為名。",
              "locator": "卷27·安州·吉阳县；归档文本第57行"
            }
          ]
        },
        {
          "topic": "administration",
          "statement": "《元和郡县图志》安州（安陆）明确领吉阳，与《旧唐书》及模型所列安州身份一致；这不连带核定模型的道级归属，也不能与岭南振州吉阳相混。",
          "evidence": [
            {
              "sourceId": "county-focus-yuanhe-27",
              "quote": "貢、賦：開元貢：紵布一十八匹。賦：綿，紵。元和貢：紵布一十匹。管縣六：安陸，應山，雲夢，孝昌，吉陽，應城。",
              "locator": "卷27·安州；归档文本第46行"
            }
          ]
        },
        {
          "topic": "chronology",
          "statement": "《新唐书》记元和三年（808）吉阳省入应山，后来恢复，未在该句注明复置年；这补充了CHGIS 606—969单段记录无法表现的撤并过程。",
          "evidence": [
            {
              "sourceId": "county-focus-xintangshu-41",
              "quote": "吉陽，〈中。元和三年省入應山，後復置。有白兆山。〉",
              "locator": "卷41·安州安陆郡；归档文本第42行"
            },
            {
              "sourceId": "county-focus-chgis",
              "quote": "SYS_ID=43673\nNAME_CH=吉阳县\nPRES_LOC=今湖北安陆市东北土桥店西南\nBEG_YR=606\nEND_YR=969",
              "locator": "CHGIS SYS_ID 43673；归档文本第11行"
            }
          ]
        },
        {
          "topic": "chronology",
          "statement": "《宋史》德安府条记“开宝中，废吉阳县”，支持宋初废县的大致时段；CHGIS的969是该记录最后有效年，不能直接标成撤县年。",
          "evidence": [
            {
              "sourceId": "county-focus-songshi-88",
              "quote": "德安府，中，安陸郡，安遠軍節度。本安州。天聖元年，隸京西路，慶暦元年還本路。宣和元年，陞爲府。開寶中，廢吉陽縣。",
              "locator": "卷88·德安府；归档文本第513行"
            },
            {
              "sourceId": "county-focus-chgis-dictionary",
              "quote": "last year for which this record is valid [before being abolished or changed to a new record]",
              "locator": "v6_data_dictionary.xlsx·main_table/gisinfo_table·end_year；归档文本第145行"
            }
          ]
        },
        {
          "topic": "seat",
          "statement": "《元和郡县图志》记吉阳县西至安州一百零三里，可供相对方位复核；原文里程没有被换算成经纬度或县域范围。",
          "evidence": [
            {
              "sourceId": "county-focus-yuanhe-27",
              "quote": "吉陽縣，中。西至州一百三里。",
              "locator": "卷27·安州·吉阳县；归档文本第57行"
            }
          ]
        }
      ],
      "unresolved": [
        "808年撤并之后的确切复置年，以及最终废县确年，仍需更细史料。",
        "“土桥店西南”的现代定位仍主要依据CHGIS，县治遗址与模型边线未获独立核准。",
        "755年存在该县与其741年近似县域是否准确是两个问题，现有史料不能消除2.3千米点面差异。"
      ]
    },
    {
      "id": "county-focus-jiyang-hainan",
      "settlementIds": [
        "chgis-county-42505"
      ],
